{
  "version": 1,
  "profile": {
    "dataRoot": "../data",
    "memoryLogRoot": "C:/path/to/memory",
    "timeZone": "Asia/Shanghai",
    "agentDir": "C:/path/to/agent",
    "header": "你是这个对话世界里的助手。按对话历史与记忆文件行动；不确定就查，不编。",
    "principals": {
      "user": { "id": "user", "name": "示例用户" },
      "agents": [{ "id": "main", "role": "main" }]
    }
  },
  "providers": [
    {
      "id": "deepseek",
      "name": "DeepSeek",
      "defaultChatEndpoint": "openai-chat-completions",
      "endpoints": {
        "openai-chat-completions": {
          "adapterFamily": "openai",
          "baseUrl": "https://api.deepseek.com/v1"
        }
      },
      "models": [
        {
          "id": "deepseek-chat",
          "capabilities": ["function-call"],
          "contextWindow": 128000,
          "maxOutputTokens": 8192
        }
      ],
      "apiKeyEnv": "DEEPSEEK_API_KEY"
    }
  ],
  "presets": [
    {
      "id": "researcher",
      "description": "读文件、整理事实、写报告。适合查资料和核对细节。",
      "models": [
        { "provider": "deepseek", "model": "deepseek-chat" }
      ],
      "tools": ["read", "recall", "fetch", "websearch"],
      "maxSteps": 8,
      "timeoutMs": 180000,
      "readOnly": true,
      "systemPrompt": "你是子 agent。只按请求完成任务；先查证据再下结论，不满足验收就明说没完成。"
    }
  ],
  "update": {
    "manifestUrl": ""
  },
  "patch": {
    "tools": { "enabled": [] },
    "agents": {
      "maxConcurrent": 3,
      "perProvider": {},
      "perPreset": {},
      "queueLimit": 20
    },
    "compaction": {
      "triggerAt": 0.85,
      "targetAt": 0.4,
      "keepRecentTurns": 12
    },
    "context": { "maxBytes": 131072 },
    "offload": {
      "enabled": true,
      "maxInlineBytes": 32768,
      "maxStructuredBytes": 32768,
      "previewHeadChars": 1200,
      "previewTailChars": 400
    },
    "runtime": {
      "model": {
        "retry": {
          "maxAttempts": 3,
          "baseDelayMs": 500,
          "maxDelayMs": 8000,
          "timeoutMs": 180000
        },
        "admission": {
          "enabled": true,
          "maxConcurrentPerProvider": 3,
          "queueLimit": 64,
          "waitMs": 120000,
          "cooldownBaseMs": 1000,
          "cooldownMaxMs": 60000
        }
      },
      "hostLease": {
        "enabled": true
      },
      "fs": { "enforce": true },
      "network": {
        "enforce": true,
        "allowPrivateNetwork": false,
        "maxRedirects": 5
      },
      "workspace": {
        "lease": {
          "enabled": true,
          "pathTtlMs": 30000,
          "workspaceTtlMs": 300000,
          "waitMs": 30000,
          "renewMs": 5000,
          "maxQueue": 20
        }
      },
      "sessions": {
        "maxTotal": 64,
        "maxPerCreator": 16,
        "recoverInbox": true
      },
      "memory": { "autoCommit": true },
      "metrics": true
    }
  }
}
