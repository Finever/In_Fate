{
  "name": "in-fate",
  "version": "0.0.1.2",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "check": "tsc --noEmit",
    "test": "node --test tests/*.test.ts",
    "start": "node bin/if.ts",
    "chat": "node bin/if.ts chat",
    "build:ui": "npm --prefix ui run build",
    "release": "npm run check && npm test && npm run build:ui && node scripts/release.mjs",
    "release:portable": "npm run check && npm test && npm run build:ui && node scripts/release.mjs --no-desktop",
    "release:smoke": "node scripts/release-smoke.mjs",
    "desktop": "npm --prefix desktop start",
    "desktop:smoke": "npm --prefix desktop run smoke",
    "desktop:shortcut": "node desktop/install-shortcut.mjs",
    "desktop:shortcut:remove": "node desktop/install-shortcut.mjs --remove",
    "memory:migrate-identity": "node bin/migrate-identity.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0"
  },
  "dependencies": {
    "node-llama-cpp": "^3.22.3"
  }
}
